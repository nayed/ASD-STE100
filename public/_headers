# Cloudflare Pages response headers (copied into dist/ by Vite).
# Vite fingerprints everything in /assets (index-3f2a9c.js…), so a file there never changes:
# let browsers keep it for a year. index.html stays revalidated, so new deploys show up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
