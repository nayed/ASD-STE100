# ── base layer: an official, pinned runtime floor
FROM docker.io/library/python:3.12-slim

WORKDIR /app

# ── deps before code: cached until requirements.txt changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── code lands last, so edits rebuild in seconds
COPY . .
EXPOSE 3000
CMD ["python", "server.py"]
